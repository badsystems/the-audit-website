# Neon Postgres connection string (Vercel > Project Settings > Environment Variables)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared password for /admin/events
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-too

# Stripe (Dashboard > Developers > API keys / Webhooks). No publishable key is
# needed — checkout uses a plain server-side redirect, not Stripe.js.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
